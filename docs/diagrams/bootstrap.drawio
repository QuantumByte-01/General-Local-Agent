        <mxCell id="note" value="Hooks are captured into memory here and never re-read from disk implicitly. MCP failures are recorded on the hub and shown in the UI banner; the process still starts." style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
