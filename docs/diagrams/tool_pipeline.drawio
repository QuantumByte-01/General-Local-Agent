        <mxCell id="note" value="Concurrency: isConcurrencySafe(input) is per-call. Unknown / parse failure / exception → serial. Results are buffered and released in submission order, not completion order." style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
